# Buckeye Trail Guide credentials (never commit real values)

# Gumroad — https://gumroad.com/settings/advanced → Create application / access token
# Needs edit_products scope
GUMROAD_ACCESS_TOKEN=

# Etsy Open API v3 — see ETSY_SETUP.md
# Prefer keystring:shared_secret in one line
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_TAXONOMY_ID=
ETSY_AUTO_PUBLISH=true
ETSY_REDIRECT_URI=https://localhost:3456/oauth/callback

# Lemon Squeezy — https://app.lemonsqueezy.com/settings/api
# Note: file attach is still manual in LS dashboard
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=

# Pinterest API v5 — see PINTEREST_SETUP.md
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=https://localhost:3457/oauth/callback
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=
# Public origin for cover images after site deploy, e.g. https://buckeyetrailguide.com
PINTEREST_IMAGE_BASE=

# Facebook Page — see FACEBOOK_SETUP.md (Graph API Explorer Page token)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
