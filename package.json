{
  "name": "facts-or-whacks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "catalog:images": "python3 scripts/resolve_catalog_images.py",
    "catalog:facts": "python3 scripts/expand_catalog_facts.py",
    "catalog:stills": "node scripts/export_catalog_stills.mjs",
    "catalog:pad": "python3 scripts/make_pad_audio.py",
    "catalog:videos": "python3 scripts/stills_to_videos.py"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
