{
  "id": "fire-lava-v1",
  "format": "cursor-card-frame-color-layers-v2",
  "canvas": {
    "width": 750,
    "height": 1050,
    "aspect_ratio": "5:7",
    "units": "px"
  },
  "transparent_background": true,
  "editable": true,
  "layer_order": [
    "greyscale_base",
    "color_warm_stone",
    "color_red",
    "color_orange",
    "color_yellow",
    "color_gold",
    "color_other"
  ],
  "layers": [
    {
      "id": "greyscale_base",
      "file": "layers/greyscale_base.png",
      "psd_name": "Greyscale Base",
      "blend": "normal",
      "visible": true,
      "opacity": 255,
      "role": "greyscale_base"
    },
    {
      "id": "color_warm_stone",
      "file": "layers/color_warm_stone.png",
      "psd_name": "Color - Warm Stone",
      "blend": "normal",
      "visible": true,
      "opacity": 255,
      "role": "color"
    },
    {
      "id": "color_red",
      "file": "layers/color_red.png",
      "psd_name": "Color - Red Ember",
      "blend": "normal",
      "visible": true,
      "opacity": 255,
      "role": "color"
    },
    {
      "id": "color_orange",
      "file": "layers/color_orange.png",
      "psd_name": "Color - Orange Lava",
      "blend": "normal",
      "visible": true,
      "opacity": 255,
      "role": "color"
    },
    {
      "id": "color_yellow",
      "file": "layers/color_yellow.png",
      "psd_name": "Color - Yellow Highlights",
      "blend": "normal",
      "visible": true,
      "opacity": 255,
      "role": "color"
    },
    {
      "id": "color_gold",
      "file": "layers/color_gold.png",
      "psd_name": "Color - Gold Metal",
      "blend": "normal",
      "visible": true,
      "opacity": 255,
      "role": "color"
    },
    {
      "id": "color_other",
      "file": "layers/color_other.png",
      "psd_name": "Color - Other",
      "blend": "normal",
      "visible": true,
      "opacity": 255,
      "role": "color"
    }
  ],
  "outputs": {
    "layered_psd": "frame.psd",
    "layered_ora": "frame.ora",
    "composite_png": "frame.png",
    "preview_png": "preview.png",
    "greyscale_preview_png": "preview-greyscale.png"
  },
  "notes": [
    "Hide all Color - * layers to leave Greyscale Base (stripped design).",
    "Toggle individual color layers for recoloring/blending.",
    "Open frame.psd in Photopea (free), Photoshop, or Affinity."
  ]
}
