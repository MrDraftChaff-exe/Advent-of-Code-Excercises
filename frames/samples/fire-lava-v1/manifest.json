{
  "id": "fire-lava-v1",
  "format": "cursor-card-frame-layers-v1",
  "canvas": {
    "width": 750,
    "height": 1050,
    "aspect_ratio": "5:7",
    "units": "px"
  },
  "transparent_background": true,
  "editable": true,
  "layer_order": [
    "outer_frame",
    "art_bezel",
    "title_plaque",
    "footer_left",
    "footer_right",
    "crests"
  ],
  "layers": [
    {
      "id": "outer_frame",
      "file": "layers/outer_frame.png",
      "psd_name": "Outer Frame",
      "blend": "normal",
      "visible": true,
      "opacity": 255
    },
    {
      "id": "art_bezel",
      "file": "layers/art_bezel.png",
      "psd_name": "Art Bezel",
      "blend": "normal",
      "visible": true,
      "opacity": 255
    },
    {
      "id": "title_plaque",
      "file": "layers/title_plaque.png",
      "psd_name": "Title Plaque",
      "blend": "normal",
      "visible": true,
      "opacity": 255
    },
    {
      "id": "footer_left",
      "file": "layers/footer_left.png",
      "psd_name": "Footer Left",
      "blend": "normal",
      "visible": true,
      "opacity": 255
    },
    {
      "id": "footer_right",
      "file": "layers/footer_right.png",
      "psd_name": "Footer Right",
      "blend": "normal",
      "visible": true,
      "opacity": 255
    },
    {
      "id": "crests",
      "file": "layers/crests.png",
      "psd_name": "Crests",
      "blend": "normal",
      "visible": true,
      "opacity": 255
    }
  ],
  "outputs": {
    "composite_png": "frame.png",
    "preview_png": "preview.png",
    "layered_psd": "frame.psd",
    "layered_ora": "frame.ora"
  },
  "notes": [
    "Primary editable file: frame.psd \u2014 toggle visibility and blend modes in Photoshop/Affinity/Photopea.",
    "Optional frame.ora for GIMP/Krita.",
    "Individual layers/*.png are also kept for scripting."
  ]
}
