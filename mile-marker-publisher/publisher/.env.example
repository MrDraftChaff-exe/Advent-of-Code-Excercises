# Mile Marker Publisher credentials (never commit real values)

# Gumroad — https://gumroad.com/settings/advanced → Create application / access token
# Needs edit_products scope
GUMROAD_ACCESS_TOKEN=

# Etsy Open API v3 — https://developers.etsy.com/
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=
# Digital download taxonomy id (look up via Etsy taxonomy API for your category)
ETSY_TAXONOMY_ID=
# Set true to flip listings from draft → active after file upload
ETSY_AUTO_PUBLISH=false

# Lemon Squeezy — https://app.lemonsqueezy.com/settings/api
# Note: file attach is still manual in LS dashboard
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
